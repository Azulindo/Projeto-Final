erDiagram
  utilizador {
    int id_utilizador PK
    varchar nome
    varchar email
    varchar password_hash
    varchar telefone
    enum tipo_utilizador
    boolean ativo
    datetime data_registo
  }
  cliente {
    int id_cliente PK
    int id_utilizador FK
    varchar morada
    text alergias
    text preferencias_alimentares
  }
  funcionario {
    int id_funcionario PK
    int id_utilizador FK
    enum cargo
    date data_contratacao
  }
  categoria {
    int id_categoria PK
    varchar nome
    text descricao
    tinyint ordem
    boolean ativo
  }
  produto {
    int id_produto PK
    int id_categoria FK
    varchar nome
    text descricao
    decimal preco
    varchar imagem_url
    boolean disponivel
    int tempo_preparacao
    boolean controla_stock
    boolean ativo
  }
  stock {
    int id_stock PK
    int id_produto FK
    int quantidade_atual
    int quantidade_minima
    datetime data_atualizacao
  }
  mesa {
    int id_mesa PK
    int numero_mesa
    int capacidade
    varchar qr_code
    enum estado
    boolean ativo
  }
  slot_horario {
    int id_slot PK
    time hora
    enum periodo
    int lotacao_maxima
    varchar dias_semana
    boolean ativo
  }
  sessao_mesa {
    int id_sessao PK
    varchar codigo_sessao

    int mesa_aberta
  }
  pedido {
    int id_pedido PK
    varchar numero_pedido
    int id_cliente FK
    int id_mesa FK
    int id_sessao FK
    int id_funcionario FK
    enum tipo_pedido
    enum estado
    datetime data_hora
    datetime data_atualizacao
    decimal valor_total
    varchar nome_convidado
    varchar email_convidado
    varchar telefone_convidado
    text observacoes
  }
  item_pedido {
    int id_item PK
    int id_pedido FK
    int id_produto FK
    int quantidade
    decimal preco_unitario
    decimal subtotal
    text observacoes
  }
  historico_estado_pedido {
    int id_historico PK
    int id_pedido FK

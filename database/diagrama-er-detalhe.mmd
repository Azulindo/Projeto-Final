    enum estado
    varchar motivo_recusa
    int id_funcionario FK
    int id_pedido FK
    datetime data_criacao
    datetime data_atualizacao
  }
  item_reserva {
    int id_item_reserva PK
    int id_reserva FK
    int id_produto FK
    int quantidade
    decimal preco_unitario
    decimal subtotal
  }
  favorito {
    int id_cliente PK
    int id_produto PK
    datetime data_adicao
  }
  avaliacao {
    int id_avaliacao PK
    int id_cliente FK
    int id_pedido FK
    tinyint classificacao
    text comentario
    datetime data_avaliacao
  }
  notificacao {
    int id_notificacao PK
    int id_cliente FK
    int id_pedido FK
    varchar email_destinatario
    varchar assunto
    text mensagem
    boolean lida

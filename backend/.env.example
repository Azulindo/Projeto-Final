# =====================================================================
#  VEM PRO ABATE — variaveis de ambiente
#
#  COPIA este ficheiro para ".env" e preenche com os valores reais.
#  O ".env" NUNCA vai para o Git (esta no .gitignore).
#  Este ".env.example" VAI, para o Guilherme saber o que precisa.
# =====================================================================

# --- Base de dados ---------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vem_pro_abate

# --- Autenticacao ----------------------------------------------------
# Gera uma string aleatoria longa. No terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Servidor --------------------------------------------------------
PORT=3000
NODE_ENV=development

# Dominios autorizados a chamar a API, separados por virgula.
ORIGEM_PERMITIDA=http://localhost:5500,http://127.0.0.1:5500

# --- Email (so a partir da tarefa B-71) ------------------------------
EMAIL_API_KEY=
EMAIL_REMETENTE=reservas@vemproabate.pt

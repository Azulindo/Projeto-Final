# =====================================================================
#  VEM PRO ABATE — variaveis de ambiente
#
#  COPIA este ficheiro para ".env" e preenche com os valores reais.
#  O ".env" NUNCA vai para o Git (esta no .gitignore).
#  Este ".env.example" VAI, para o Guilherme saber o que precisa.
# =====================================================================

# --- Base de dados ---------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vem_pro_abate

# --- Autenticacao ----------------------------------------------------
# Gera uma string aleatoria longa. No terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Servidor --------------------------------------------------------
PORT=3000
NODE_ENV=development

# Dominios autorizados a chamar a API, separados por virgula.
ORIGEM_PERMITIDA=http://localhost:5500,http://127.0.0.1:5500

# --- Email (B-71 e B-72) ---------------------------------------------
#
# SEM a EMAIL_API_KEY nada disto rebenta: o aviso continua a ser gravado
# na tabela `notificacao` e so o envio e que nao acontece. E assim de
# proposito — no plano B, sem internet, o sistema tem de continuar a
# funcionar inteiro menos a parte que depende da internet.
#
# Ha dois caminhos. Preenche UM dos dois, ou nenhum.
#
# ---- Caminho 1: Gmail (e o que a casa usa) --------------------------
#
# A EMAIL_GMAIL_APP_PASSWORD NAO e a palavra-passe da conta Google. E
# uma "palavra-passe de aplicacao", de 16 letras, gerada na conta:
#   conta Google -> Seguranca -> Palavras-passe de aplicacao
# Para a opcao aparecer, a verificacao em dois passos tem de estar
# ligada. Serve so para isto e revoga-se sozinha sem mexer na conta.
#
# Precisa do nodemailer:  cd backend && npm install nodemailer
# Sem ele, o envio fica desligado e a API arranca na mesma.
EMAIL_GMAIL_UTILIZADOR=
EMAIL_GMAIL_APP_PASSWORD=
#
# ---- Caminho 2: Brevo, por HTTP (nao precisa de instalar nada) ------
EMAIL_API_KEY=
EMAIL_REMETENTE=
#
# As duas de cima ficam VAZIAS aqui. Este ficheiro vai para o GitHub.
# Para onde vai o aviso de pedido novo. Sem isto, fica gravado na
# notificacao com destinatario vazio e nao se tenta enviar.
EMAIL_RESTAURANTE=
